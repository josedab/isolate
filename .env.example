# Isolate Server Environment Configuration
# Copy this file to .env and modify as needed.

# Logging level (trace, debug, info, warn, error)
RUST_LOG=info

# Enable backtraces on panics (0 or 1)
RUST_BACKTRACE=0

# OpenTelemetry OTLP exporter endpoint (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# OpenTelemetry service name
OTEL_SERVICE_NAME=isolate-server

# Docker Compose overrides (used by docker-compose.yml)
# ISOLATE_HOST=0.0.0.0
# ISOLATE_PORT=50051

# --- Server Configuration ---

# Maximum number of concurrent sandboxes (default: 100)
# ISOLATE_MAX_SANDBOXES=100

# Enable the warm pool for faster sandbox creation (default: disabled)
# ISOLATE_WARM_POOL=false

# Number of pre-warmed instances per module when warm pool is enabled (default: 5)
# ISOLATE_WARM_POOL_SIZE=5

# HTTP health/dashboard endpoint address (default: 0.0.0.0:8080)
# ISOLATE_HEALTH_ADDR=0.0.0.0:8080

# Disable HTTP health endpoint (set to 1 to disable)
# ISOLATE_NO_HEALTH_HTTP=0

# Enable JSON-formatted log output (set to 1 to enable)
# ISOLATE_JSON_LOGS=0

# OpenTelemetry sampling ratio (0.0 to 1.0, default: 1.0)
# OTEL_SAMPLING_RATIO=1.0
