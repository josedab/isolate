# EditorConfig for Isolate
# https://editorconfig.org

root = true

# Default settings for all files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Rust files
[*.rs]
indent_size = 4
max_line_length = 100

# YAML and TOML files
[*.{yml,yaml,toml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# JSON files
[*.json]
indent_size = 2

# Protocol buffers
[*.proto]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2

# Makefiles require tabs
[Makefile]
indent_style = tab

# GitHub Actions
[.github/**/*.yml]
indent_size = 2

# Python files
[*.py]
indent_size = 4
max_line_length = 88
