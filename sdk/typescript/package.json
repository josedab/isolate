{
  "name": "@isolate/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Isolate gRPC sandbox service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "jest --config jest.config.js"
  },
  "keywords": [
    "isolate",
    "sandbox",
    "wasm",
    "webassembly",
    "grpc",
    "security"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.12",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/josedab/isolate.git",
    "directory": "sdk/typescript"
  }
}
